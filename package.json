{
  "name": "java-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "test": "node --import tsx --test content/*.test.ts src/main/services/*.test.ts src/main/db/*.test.ts src/main/ai/*.test.ts src/renderer/src/design/*.test.ts scripts/author/*.test.ts",
    "author": "tsx scripts/author/run.ts",
    "validate:all": "tsx scripts/validate-all.ts && tsx scripts/validate-concepts.ts",
    "review": "tsx scripts/author/review.ts",
    "tutor": "tsx scripts/tutor-once.ts",
    "bench:stream": "tsx scripts/bench-stream.ts",
    "validate:concepts": "tsx scripts/validate-concepts.ts",
    "review:one": "tsx scripts/review-once.ts",
    "icon": "tsx scripts/make-icon.ts",
    "package": "npm run icon && npm run build && electron-builder --mac",
    "selftest": "npm run build && electron-vite preview -- --selftest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@anthropic-ai/sdk": "^0.124.0",
    "@fontsource/archivo": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "gsap": "^3.15.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.0.0"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "description": "Learn Java from scratch through DSA and competitive programming, with an AI tutor. Local-first, macOS.",
  "author": {
    "name": "Shreyas Kothakonda",
    "email": "hello@shreyas.live"
  }
}
